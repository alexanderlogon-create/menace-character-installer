<Window x:Class="MenaceCharacterInstaller.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MENACE Character Installer" Width="1240" Height="970" MinWidth="1030" MinHeight="800" Background="#0C100D" Foreground="#E6E7DE" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MENACE / CHARACTER INSTALLER" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Gold}"/><TextBlock Text="{DynamicResource subtitle}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="PREVIEW 0.3.1" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox x:Name="LanguageBox" Width="110" Padding="8,5" SelectionChanged="Language_Changed" AutomationProperties.Name="Language / Язык"><ComboBoxItem Tag="ru" Content="Русский"/><ComboBoxItem Tag="en" Content="English"/></ComboBox></StackPanel></Grid>
  <Border Grid.Row="1" Background="#161D14" BorderBrush="#414C34" BorderThickness="1" Padding="16" Margin="0,0,0,16"><ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350"><StackPanel>
   <TextBlock Text="{DynamicResource game}" Foreground="{StaticResource Gold}" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="DetectButton" Content="{DynamicResource detect}" Click="Detect_Click"/><Button x:Name="BrowseButton" Content="{DynamicResource browse}" Click="Browse_Click"/><Button x:Name="CheckButton" Content="{DynamicResource check}" Click="Check_Click"/></StackPanel><TextBox x:Name="GamePath" AutomationProperties.Name="{DynamicResource gamepath}"/></DockPanel>
   <TextBlock x:Name="GameStatus" Margin="0,10,0,0" Foreground="{StaticResource Muted}"/>

   <CheckBox x:Name="AllowUnverified" Content="{DynamicResource allow}" Visibility="Collapsed" Margin="0,10,0,0"/>
   <TextBlock Text="{DynamicResource source}" Foreground="{StaticResource Gold}" FontWeight="SemiBold" Margin="0,14,0,8"/>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SourceButton" Content="{DynamicResource openzip}" Click="Source_Click"/><Button x:Name="BundledButton" Content="{DynamicResource bundled}" Click="Bundled_Click"/></StackPanel><TextBox x:Name="SourcePath" IsReadOnly="True" AutomationProperties.Name="{DynamicResource archivepath}"/></DockPanel>
   <TextBlock x:Name="PackInfo" Margin="0,8,0,0"/>
   <ItemsControl x:Name="DependenciesList" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate><Border Background="#0B110D" BorderBrush="#414C34" BorderThickness="1" Padding="9" Margin="0,0,6,6">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Ellipse Width="11" Height="11" Fill="{Binding Light}" VerticalAlignment="Top" Margin="0,5,8,0"/>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding Light}"/></StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center">
       <Button Content="{DynamicResource depinstall}" Tag="{Binding Name}" ToolTip="{Binding Hint}" Visibility="{Binding DownloadVisibility}" Click="DependencyInstall_Click" Padding="8,5" FontSize="12"/>
       <Button Content="{Binding WebsiteLabel}" Tag="{Binding DownloadPage}" Visibility="{Binding WebsiteVisibility}" Click="Download_Click" Padding="8,3" FontSize="11" Margin="4,5,4,0"/>
      </StackPanel>
     </Grid>
    </Border></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock x:Name="PackNotices" Margin="0,3,0,0" Foreground="{StaticResource Muted}" FontSize="12"/>
  </StackPanel></ScrollViewer></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><TextBlock Text="{DynamicResource roster}" Foreground="{StaticResource Gold}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="SelectionCount" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="AllButton" Content="{DynamicResource all}" Click="All_Click"/><Button x:Name="NoneButton" Content="{DynamicResource none}" Click="None_Click"/></StackPanel><TextBox x:Name="Search" TextChanged="Search_Changed" ToolTip="{DynamicResource search}" AutomationProperties.Name="{DynamicResource search}"/></DockPanel>
    <ListBox x:Name="Roster" Grid.Row="2" Foreground="{StaticResource Ink}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Roster_SelectionChanged">
     <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Width" Value="244"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="#161D14" BorderBrush="#414C34" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#DFC875"/><Setter TargetName="Tile" Property="Background" Value="#2D3824"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#DFC875"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid Margin="10" Height="88"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="72"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}"/><Image Grid.Column="1" Source="{Binding Portrait}" Stretch="Uniform"/><StackPanel Grid.Column="2" Margin="12,6,0,0"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock Text="{Binding InstalledLabel}" FontSize="11" Foreground="{StaticResource Gold}" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
   <Border Grid.Column="2" Background="#161D14" BorderBrush="#414C34" BorderThickness="1" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Image x:Name="DetailPortrait" Height="150" HorizontalAlignment="Left"/><TextBlock x:Name="NoPortrait" Text="{DynamicResource missingpreview}" Visibility="Collapsed" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DetailName" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,14,0,0"/>
    <TextBlock x:Name="DetailFullName" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/><TextBlock x:Name="DetailRole" Margin="0,10,0,0"/>
    <TextBlock x:Name="DetailDescription" Margin="0,16,8,0" LineHeight="22"/><TextBlock x:Name="DetailStats" Margin="0,16,8,0" Foreground="{StaticResource Muted}" LineHeight="21"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,16,0,0">
   <TextBlock Text="{DynamicResource campaign}" Foreground="{StaticResource Muted}" FontSize="12"/>
   <ProgressBar x:Name="Progress" Height="3" Margin="0,10,0,10" Foreground="{StaticResource Gold}" Background="#252E20"/>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CancelButton" Content="{DynamicResource cancel}" Click="Cancel_Click" IsEnabled="False"/><Button x:Name="RestoreButton" Content="{DynamicResource restore}" Click="Restore_Click"/><Button x:Name="InstallButton" Content="{DynamicResource install}" Background="#DFC875" Foreground="#10170D" FontWeight="SemiBold" Click="Install_Click"/></StackPanel><TextBlock x:Name="Status" Text="{DynamicResource loading}" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel>
   <DockPanel Margin="0,10,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{DynamicResource mods}" Padding="8,4" Click="Mods_Click"/><Button Content="{DynamicResource logs}" Padding="8,4" Click="Logs_Click"/></StackPanel><TextBlock Text="{DynamicResource footer}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
  </StackPanel>
 </Grid>
</Window>
